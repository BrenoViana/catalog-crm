PORT=3000

# Ambiente. Deixe "development" so na sua maquina. Em producao use "production":
# varias travas de seguranca dependem disto (segredo do JWT, seed, gateways).
NODE_ENV=development

# --- Pagamentos ---
# O provedor eletronico simulado (Pix/cartao) CONFIRMA QUALQUER VALOR sem cobrar
# nada. Numa loja real isso e entregar mercadoria de graca. Ele so sobe com
# NODE_ENV=development ou com a chave abaixo ligada de proposito.
# Em producao: configure um gateway real e mantenha esta variavel em false.
ALLOW_FAKE_PAYMENT_GATEWAY=false

# Segredo do JWT: OBRIGATORIO em producao, >= 32 caracteres, aleatorio.
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Origens permitidas no CORS (lista separada por virgula, sem barra final)
CORS_ORIGIN=http://localhost:5173

# Rate limit do login (opcional)
LOGIN_RATELIMIT_MAX=10
LOGIN_RATELIMIT_WINDOW_MS=60000

# --- Banco de dados ---
# Desenvolvimento local sem Docker: rode `npx prisma dev -d` dentro de backend/
# e cole abaixo as URLs TCP que ele exibe em `npx prisma dev ls`
# (porta ~51214 = banco, ~51215 = shadow db usado pelo Prisma Migrate).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Producao / Postgres tradicional (Docker, RDS, etc.):
# DATABASE_URL="postgres://usuario:senha@host:5432/catalog_crm"

# --- Licenciamento por modulos ---
# Chave PUBLICA do fornecedor (PEM em uma linha, com 
). A instalacao so
# verifica; a privada fica com o fornecedor e nunca entra aqui.
# Ausente => somente o NUCLEO e liberado (o caixa continua funcionando).
LICENSE_PUBLIC_KEY=""

# Servidor de renovacao (opcional, https). A chave assinada vale sozinha sem
# rede; isto so troca por uma mais nova quando ha internet. Falha e silenciosa.
# LICENSE_RENEW_URL="https://licencas.seu-dominio.com.br/v1/renovar"
