PORT=3000
JWT_SECRET=troque-esta-chave-em-producao

# --- Banco de dados ---
# Desenvolvimento local sem Docker: rode `npx prisma dev -d` dentro de backend/
# e cole abaixo as URLs TCP que ele exibe em `npx prisma dev ls`
# (porta ~51214 = banco, ~51215 = shadow db usado pelo Prisma Migrate).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Producao / Postgres tradicional (Docker, RDS, etc.):
# DATABASE_URL="postgres://usuario:senha@host:5432/catalog_crm"
# (nesse caso SHADOW_DATABASE_URL e opcional)
