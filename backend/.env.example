PORT=3000

# Segredo do JWT: OBRIGATORIO em producao, >= 32 caracteres, aleatorio.
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Origens permitidas no CORS (lista separada por virgula, sem barra final)
CORS_ORIGIN=http://localhost:5173

# Rate limit do login (opcional)
LOGIN_RATELIMIT_MAX=10
LOGIN_RATELIMIT_WINDOW_MS=60000

# --- Banco de dados ---
# Desenvolvimento local sem Docker: rode `npx prisma dev -d` dentro de backend/
# e cole abaixo as URLs TCP que ele exibe em `npx prisma dev ls`
# (porta ~51214 = banco, ~51215 = shadow db usado pelo Prisma Migrate).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Producao / Postgres tradicional (Docker, RDS, etc.):
# DATABASE_URL="postgres://usuario:senha@host:5432/catalog_crm"
