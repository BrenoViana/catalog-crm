// Catalog CRM - varejo B2C (catalogo + PDV) para loja unica com atendimento ao publico.
// Foco: catalogo de produtos, estoque, venda de balcao, caixa por turno e
// emissao de NFC-e (modelo 65) via gateway fiscal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  GERENTE
  OPERADOR
}

/// Como o item e vendido: por unidade ou por peso (balanca, EAN-13 prefixo 2).
enum PricingMode {
  UNIT
  WEIGHT
}

/// Como a promocao calcula o desconto do item.
enum PromotionKind {
  /// Percentual sobre o preco do item.
  PERCENT
  /// Valor fixo em R$ por unidade.
  AMOUNT
  /// Preco fixo por unidade enquanto a promocao valer.
  FIXED_PRICE
  /// Leve X, pague Y: as unidades excedentes de cada bloco saem de graca.
  BUY_X_PAY_Y
}

/// A que itens a promocao se aplica.
enum PromotionScope {
  /// Um produto especifico.
  PRODUCT
  /// Todos os produtos de uma categoria.
  CATEGORY
  /// Todo o catalogo.
  ALL
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  VENDA
  DEVOLUCAO
  PERDA
}

enum SaleStatus {
  ABERTA
  CONCLUIDA
  CANCELADA
}

enum PaymentMethod {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  CREDIARIO
  OUTRO
  /// Resgate de saldo de fidelidade. Nao entra na gaveta e nao vira titulo:
  /// e credito que a propria loja concedeu e agora esta devolvendo.
  FIDELIDADE
}

/// Ciclo de vida de um pagamento. Dinheiro nasce CONFIRMADO; meios
/// eletronicos passam pelo PaymentGateway antes de virar confirmado.
enum PaymentStatus {
  PENDENTE
  PROCESSANDO
  AUTORIZADO
  CONFIRMADO
  NEGADO
  ESTORNADO
}

enum FiscalStatus {
  NAO_EMITIDA
  PENDENTE
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  CONTINGENCIA
}

/// Como a venda entrou no sistema. ONLINE e o balcao normal, com o banco
/// disponivel. CONTINGENCIA marca a venda registrada enquanto a emissao da
/// NFC-e roda numa serie propria de contingencia — a nota so chega a SEFAZ na
/// reconexao.
enum SaleOrigin {
  ONLINE
  CONTINGENCIA
}

/// Tipo de emissao do documento fiscal. CONTINGENCIA_OFFLINE numera numa serie
/// reservada e, no XML de verdade, corresponde a tpEmis=9 + dhCont; a
/// transmissao a SEFAZ acontece depois, sem renumerar.
enum FiscalEmissionType {
  NORMAL
  CONTINGENCIA_OFFLINE
}

enum CashSessionStatus {
  ABERTA
  FECHADA
}

enum CashMovementType {
  ABERTURA
  VENDA
  SANGRIA
  SUPRIMENTO
  FECHAMENTO
}

/// Situacao do fechamento financeiro de um dia de operacao.
enum DailyClosingStatus {
  /// Dia consolidado e travado.
  FECHADO
  /// Dia reaberto por um gerente — a trava caiu e o retrato anterior ficou
  /// guardado no snapshot ate o proximo fechamento.
  REABERTO
}

/// Ciclo de vida de um titulo (a receber ou a pagar).
enum TitleStatus {
  ABERTO
  /// Baixado em parte: ha pagamento, mas ainda sobra saldo.
  PARCIAL
  PAGO
  CANCELADO
}

/// Periodicidade de uma despesa que se repete (aluguel, energia, folha).
enum PayableRecurrence {
  NENHUMA
  SEMANAL
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

/// O que moveu o saldo de fidelidade do cliente.
enum LoyaltyEntryType {
  /// Cashback gerado por uma venda.
  ACUMULO
  /// Saldo usado como pagamento no PDV.
  RESGATE
  /// Ajuste manual de gerente (bonus ou correcao).
  AJUSTE
  /// Estorno de acumulo ou de resgate por cancelamento da venda.
  ESTORNO
}

/// Com que periodicidade um relatorio agendado e enviado.
enum ReportFrequency {
  DIARIO
  SEMANAL
  MENSAL
}

/// Por onde o relatorio agendado sai da loja.
enum ReportChannel {
  /// Provedor de registro: nao envia nada, grava o anexo na trilha de entregas.
  /// E o padrao ate a loja configurar um canal real — o agendamento fica
  /// exercitavel (e auditavel) sem depender de credencial de terceiro.
  REGISTRO
  EMAIL
  WHATSAPP
}

/// Desfecho de uma tentativa de envio.
enum ReportDeliveryStatus {
  ENVIADO
  FALHOU
}

enum TaxRegime {
  SIMPLES_NACIONAL
  SIMPLES_EXCESSO
  REGIME_NORMAL
}

/// Natureza de uma conta financeira: onde o dinheiro da loja fica.
enum FinancialAccountType {
  /// Conta bancaria (corrente, poupanca, conta de pagamento).
  BANCO
  /// Dinheiro em especie sob controle do caixa/gaveta.
  CAIXA
  /// Dinheiro em especie fora do caixa (cofre, fundo fixo).
  CARTEIRA
}

/// Se um no do plano de contas classifica entrada ou saida de dinheiro.
enum FinancialCategoryKind {
  RECEITA
  DESPESA
}

// ---------------------------------------------------------------------------
// Usuarios / acesso
// ---------------------------------------------------------------------------

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  name         String
  /// Papel legado (enum). Mantido só para leitura de dados antigos e para o
  /// seed; a autorizacao real sai de roleId -> RolePermission.
  role         Role        @default(OPERADOR)
  roleId       String?
  accessRole   AccessRole? @relation(fields: [roleId], references: [id])
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  sales                 Sale[]
  cashSessions          CashSession[]
  stockMovements        StockMovement[]
  cashMovements         CashMovement[]
  saleReturns           SaleReturn[]
  overrides             UserPermission[]
  auditActions          AuditLog[]             @relation("AuditActor")
  auditApprovals        AuditLog[]             @relation("AuditApprover")
  receivableSettlements ReceivableSettlement[]
  payableSettlements    PayableSettlement[]
  payablesCreated       Payable[]
  loyaltyEntries        LoyaltyEntry[]
  dailyClosings         DailyClosing[]         @relation("DailyClosingClosedBy")
  dailyClosingsReopened DailyClosing[]         @relation("DailyClosingReopenedBy")
  reportSchedules       ReportSchedule[]
  financialTransfers    AccountTransfer[]

  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Permissionamento (RBAC): catalogo de permissoes -> papeis -> usuarios,
// com excecoes por usuario. Tudo no banco; nada de papel fixo no codigo.
// ---------------------------------------------------------------------------

/// Uma capacidade granular do sistema, ex.: "sales.cancel".
/// As linhas sao semeadas pelo backend (PERMISSION_CATALOG) a cada boot.
model Permission {
  key         String  @id
  group       String
  label       String
  description String?
  /// Ordem de exibicao dentro do grupo na tela de permissoes.
  sortOrder   Int     @default(0)

  roles RolePermission[]
  users UserPermission[]

  @@index([group])
}

/// Conjunto nomeado de permissoes. `system` marca os papeis internos
/// (Administrador, Gerente, Operador): nao podem ser apagados nem renomeados,
/// mas o Administrador pode ajustar as permissoes de Gerente e Operador.
model AccessRole {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  roleId        String
  role          AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

/// Excecao por usuario: concede (allow=true) ou revoga (allow=false) uma
/// permissao independentemente do papel. Sempre vence sobre o papel.
model UserPermission {
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  allow         Boolean

  @@id([userId, permissionKey])
  @@index([permissionKey])
}

/// Configuracao do sistema em chave/valor — tira do codigo o que e ajustavel
/// (limites de rate limit, parcelas maximas, retentativa fiscal, ...).
model AppSetting {
  key         String   @id
  value       Json
  group       String   @default("geral")
  label       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([group])
}

// ---------------------------------------------------------------------------
// Catalogo
// ---------------------------------------------------------------------------

model Category {
  id         String      @id @default(uuid())
  name       String
  parentId   String?
  parent     Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]  @relation("CategoryTree")
  products   Product[]
  promotions Promotion[]

  createdAt DateTime @default(now())
}

/// Dados fiscais reutilizaveis por varios produtos (evita repetir NCM/CFOP/CSOSN).
model TaxGroup {
  id          String  @id @default(uuid())
  name        String
  /// Origem da mercadoria (0=nacional ... 8), conforme tabela da NF-e.
  origin      Int     @default(0)
  ncm         String?
  cest        String?
  cfop        String  @default("5102")
  /// CSOSN (Simples) ou CST de ICMS (regime normal).
  csosn       String  @default("102")
  cstPis      String  @default("49")
  cstCofins   String  @default("49")
  icmsRate    Decimal @default(0) @db.Decimal(6, 2)
  description String?

  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String      @id @default(uuid())
  sku         String      @unique
  barcode     String?     @unique
  name        String
  description String?
  unit        String      @default("UN")
  /// UNIT: quantidade inteira. WEIGHT: preco e por unidade de peso (kg) e a
  /// quantidade vem da balanca (peso embutido no EAN-13 de prefixo 2).
  pricingMode PricingMode @default(UNIT)
  price       Decimal     @db.Decimal(12, 2)
  cost        Decimal?    @db.Decimal(12, 2)
  /// Foto por URL externa (https://). Usada como reserva quando nao ha foto
  /// carregada na loja (`photo`), que tem precedencia.
  imageUrl    String?
  active      Boolean     @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  taxGroupId String?
  taxGroup   TaxGroup? @relation(fields: [taxGroupId], references: [id])

  photo          ProductImage?
  stock          StockItem?
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  returnItems    SaleReturnItem[]
  promotions     Promotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Foto do produto carregada pela loja.
///
/// Os bytes ficam no proprio banco (e nao em disco) de proposito: a loja e
/// unica, o volume e pequeno (um produto = uma foto de ~60 KB) e assim o
/// backup/restauracao do Postgres ja leva o catalogo inteiro, sem volume
/// extra para configurar no deploy.
///
/// A imagem chega ja recortada em quadrado e recomprimida pelo navegador, em
/// duas versoes: `data` (exibicao, ate 1000px) e `thumb` (lista/PDV, 200px).
/// A tabela e separada de Product porque TODA listagem de produto carrega o
/// registro inteiro: com os bytes na mesma linha, `GET /products` passaria a
/// trafegar megabytes.
model ProductImage {
  id        String  @id @default(uuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Identificador opaco que aparece na URL publica da imagem. Trocado a cada
  /// upload: e o que permite servir com cache imutavel (a URL nova invalida a
  /// antiga) sem expor o id do produto nem depender de query string.
  token String @unique

  /// Sempre um tipo raster (image/webp, image/jpeg, image/png) confirmado
  /// pelos bytes magicos no servidor. SVG e recusado: e documento executavel.
  contentType String
  data        Bytes
  thumb       Bytes
  byteSize    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Estoque
// ---------------------------------------------------------------------------

/// Regra de desconto automatico aplicada pelo servidor no fechamento da venda.
///
/// O PDV nunca decide desconto de promocao: ele pode simular
/// (POST /promotions/simulate) para mostrar ao cliente, mas o valor que vale e
/// o recalculado em SalesService.create. Preco e desconto vindos do cliente
/// continuam sendo ignorados.
model Promotion {
  id          String  @id @default(uuid())
  name        String
  description String?
  active      Boolean @default(true)

  kind  PromotionKind
  scope PromotionScope

  /// Alvo quando scope = PRODUCT.
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  /// Alvo quando scope = CATEGORY.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  /// PERCENT: 0-100. AMOUNT: R$ por unidade. FIXED_PRICE: preco por unidade.
  value  Decimal? @db.Decimal(12, 2)
  /// BUY_X_PAY_Y: leve `buyQty`, pague `payQty`.
  buyQty Int?
  payQty Int?

  /// Quantidade minima do item para a regra valer.
  minQuantity Decimal? @db.Decimal(12, 3)

  /// Vigencia. Nulo = sem limite daquele lado.
  startsAt DateTime?
  endsAt   DateTime?

  /// Maior prioridade vence quando duas regras alcancam o mesmo item.
  /// Empate desempata pelo maior desconto para o cliente.
  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, startsAt, endsAt])
  @@index([scope, productId])
  @@index([scope, categoryId])
}

model StockItem {
  id          String   @id @default(uuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Decimal  @default(0) @db.Decimal(12, 3)
  minQuantity Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime @updatedAt
}

model StockMovement {
  id        String            @id @default(uuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  type      StockMovementType
  quantity  Decimal           @db.Decimal(12, 3)
  reason    String?
  userId    String?
  user      User?             @relation(fields: [userId], references: [id])
  saleId    String?
  sale      Sale?             @relation(fields: [saleId], references: [id])
  createdAt DateTime          @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Clientes (B2C, leve; opcional na venda)
// ---------------------------------------------------------------------------

model Customer {
  id        String    @id @default(uuid())
  name      String
  document  String? // CPF
  phone     String?
  email     String?
  birthDate DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  /// Teto do crediario deste cliente. 0 = nao compra a prazo. O limite e
  /// consumido pelos titulos em aberto, nao pelo historico de compras.
  creditLimit Decimal @default(0) @db.Decimal(12, 2)

  sales       Sale[]
  receivables Receivable[]
  loyalty     LoyaltyAccount?

  @@index([document])
}

// ---------------------------------------------------------------------------
// Vendas / PDV
// ---------------------------------------------------------------------------

model Sale {
  id          String     @id @default(uuid())
  number      Int        @unique
  status      SaleStatus @default(ABERTA)
  origin      SaleOrigin @default(ONLINE)
  /// Nome do terminal/caixa que registrou a venda (por dispositivo). Mantido
  /// como rotulo para exibicao e relatorios; a identidade estavel e terminalId.
  terminal    String?
  /// Terminal registrado que originou a venda. Anulavel: vendas historicas e
  /// terminais nunca cadastrados ficam sem vinculo.
  terminalId  String?
  terminalRef Terminal?  @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  /// Chave idempotente do cliente que emitiu a venda (fila offline). So existe
  /// junto de terminalId; um reenvio com o mesmo par devolve a venda ja
  /// gravada, nunca uma segunda.
  clientRef   String?
  subtotal    Decimal    @default(0) @db.Decimal(12, 2)
  discount    Decimal    @default(0) @db.Decimal(12, 2)
  total       Decimal    @default(0) @db.Decimal(12, 2)
  note        String?

  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  operatorId    String
  operator      User         @relation(fields: [operatorId], references: [id])
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  items          SaleItem[]
  payments       Payment[]
  fiscalDocument FiscalDocument?
  stockMovements StockMovement[]
  cashMovements  CashMovement[]
  returns        SaleReturn[]

  createdAt      DateTime       @default(now())
  completedAt    DateTime?
  canceledAt     DateTime?
  cancelReason   String?
  receivables    Receivable[]
  loyaltyEntries LoyaltyEntry[]

  @@unique([terminalId, clientRef])
  @@index([status])
  @@index([createdAt])
  @@index([terminalId])
}

model SaleItem {
  id            String   @id @default(uuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  description   String // snapshot do nome do produto no momento da venda
  quantity      Decimal  @db.Decimal(12, 3)
  unitPrice     Decimal  @db.Decimal(12, 2) // snapshot do preco
  /// Desconto total do item = concedido pelo operador + promocional.
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  /// Parte do desconto que veio de campanha automatica, e qual campanha foi.
  /// Snapshot: a promocao pode ser editada ou apagada depois da venda.
  promoDiscount Decimal  @default(0) @db.Decimal(12, 2)
  promotionId   String?
  promotionName String?
  total         Decimal  @db.Decimal(12, 2)
  /// Snapshot do custo unitario do produto no momento da venda.
  /// Sem ele a margem historica se desloca a cada reprecificacao de fornecedor:
  /// o relatorio recalculava o CMV de ontem com o custo de hoje. `null` quando
  /// o produto nao tinha custo cadastrado — a linha fica sem margem, e a
  /// cobertura e informada em vez de fingir precisao.
  unitCost      Decimal? @db.Decimal(12, 2)

  returnItems SaleReturnItem[]

  @@index([saleId])
}

model Payment {
  id           String        @id @default(uuid())
  saleId       String
  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  installments Int?
  createdAt    DateTime      @default(now())

  // Costura de pagamentos: o que o gateway devolve fica aqui.
  status            PaymentStatus @default(CONFIRMADO)
  provider          String?
  externalId        String?
  authorizationCode String?
  /// Payload do QR (Pix) para o cliente pagar.
  qrCode            String?
  rejectionReason   String?
  authorizedAt      DateTime?
  refundedAt        DateTime?

  @@index([saleId])
  @@index([status])
}

/// Trilha de auditoria de operacoes sensiveis: quem fez, quem liberou e sobre o que.
model AuditLog {
  id            String   @id @default(uuid())
  action        String
  permissionKey String?
  actorId       String
  actor         User     @relation("AuditActor", fields: [actorId], references: [id])
  /// Supervisor que autorizou na hora, quando a acao exigiu liberacao.
  approverId    String?
  approver      User?    @relation("AuditApprover", fields: [approverId], references: [id])
  targetType    String?
  targetId      String?
  detail        Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

/// Devolucao (total ou parcial) de itens de uma venda ja concluida. Nao altera
/// a venda original — repoe estoque e, se em dinheiro, sai do caixa como sangria.
model SaleReturn {
  id            String        @id @default(uuid())
  number        Int           @unique
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id])
  operatorId    String
  operator      User          @relation(fields: [operatorId], references: [id])
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id])
  reason        String
  refundMethod  PaymentMethod
  total         Decimal       @db.Decimal(12, 2)
  /// Quanto desta devolucao saiu de fato da gaveta.
  ///
  /// Nem tudo que a venda cobrou virou dinheiro: crediario e uma promessa e o
  /// resgate de fidelidade e credito da propria loja. A devolucao rateia o
  /// total pelas formas originais, e so esta fatia sangra o caixa. O valor fica
  /// GRAVADO, e nao recalculado depois, pela mesma razao de
  /// `SaleItem.promoDiscount`: o numero que explica o dinheiro tem de
  /// sobreviver a qualquer mudanca posterior na venda ou na regra.
  cashRefunded  Decimal       @default(0) @db.Decimal(12, 2)

  items     SaleReturnItem[]
  createdAt DateTime         @default(now())

  @@index([saleId])
}

model SaleReturnItem {
  id          String     @id @default(uuid())
  returnId    String
  saleReturn  SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId  String
  saleItem    SaleItem   @relation(fields: [saleItemId], references: [id])
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  description String
  quantity    Decimal    @db.Decimal(12, 3)
  unitPrice   Decimal    @db.Decimal(12, 2)
  total       Decimal    @db.Decimal(12, 2)

  @@index([returnId])
  @@index([saleItemId])
}

// ---------------------------------------------------------------------------
// Fiscal (NFC-e modelo 65)
// ---------------------------------------------------------------------------

model FiscalDocument {
  id                     String             @id @default(uuid())
  saleId                 String             @unique
  sale                   Sale               @relation(fields: [saleId], references: [id])
  model                  Int                @default(65)
  series                 Int
  number                 Int
  status                 FiscalStatus       @default(PENDENTE)
  emissionType           FiscalEmissionType @default(NORMAL)
  environment            String             @default("homologacao")
  provider               String?
  accessKey              String?            @unique
  protocol               String?
  qrCode                 String?
  xmlUrl                 String?
  danfeUrl               String?
  rejectionReason        String?
  attempts               Int                @default(0)
  lastAttemptAt          DateTime?
  /// Momento em que o documento entrou em contingencia (o dhCont da NFC-e).
  emittedInContingencyAt DateTime?
  /// Agenda do runner de reconciliacao: proxima tentativa de transmitir a
  /// contingencia a SEFAZ. Backoff exponencial enquanto o provedor nao responde.
  contingencyRetryAt     DateTime?
  issuedAt               DateTime?
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())

  @@unique([model, series, number])
  @@index([status])
  @@index([status, contingencyRetryAt])
}

// ---------------------------------------------------------------------------
// Caixa (sessao por turno)
// ---------------------------------------------------------------------------

model CashSession {
  id                    String            @id @default(uuid())
  operatorId            String
  operator              User              @relation(fields: [operatorId], references: [id])
  status                CashSessionStatus @default(ABERTA)
  /// Terminal/caixa em que o turno foi aberto (rotulo para exibicao).
  terminal              String?
  /// Terminal registrado em que o turno foi aberto. Anulavel, como em Sale.
  terminalId            String?
  terminalRef           Terminal?         @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  openingAmount         Decimal           @db.Decimal(12, 2)
  openedAt              DateTime          @default(now())
  closingCountedAmount  Decimal?          @db.Decimal(12, 2)
  closingExpectedAmount Decimal?          @db.Decimal(12, 2)
  difference            Decimal?          @db.Decimal(12, 2)
  closedAt              DateTime?
  notes                 String?

  sales                 Sale[]
  movements             CashMovement[]
  returns               SaleReturn[]
  receivableSettlements ReceivableSettlement[]
  payableSettlements    PayableSettlement[]

  @@index([status])
  @@index([terminalId])
}

/// Terminal/caixa registrado. Hoje o nome do terminal vive so no localStorage
/// do dispositivo; este cadastro da a ele uma identidade estavel no servidor —
/// pre-requisito para a numeracao de contingencia (uma serie fiscal reservada
/// por terminal) e para a fila offline que vira depois.
model Terminal {
  id     String  @id @default(uuid())
  /// Codigo curto e estavel do dispositivo (ex.: "CAIXA-01"). Nunca muda depois
  /// de criado: e a identidade que a venda offline carrega.
  code   String  @unique
  name   String
  active Boolean @default(true)

  /// Faixa de numeracao fiscal de contingencia reservada a ESTE terminal.
  /// Nula = o terminal usa a serie de contingencia da loja (StoreSettings).
  contingencySeries     Int?
  contingencyRangeStart Int?
  contingencyRangeEnd   Int?
  contingencyNextNumber Int?

  /// Toque a cada venda / abertura de turno vindos deste terminal.
  lastSeenAt DateTime?
  /// Reservado para a fila offline: ultima sincronizacao bem-sucedida.
  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales        Sale[]
  cashSessions CashSession[]

  @@index([active])
}

model CashMovement {
  id            String           @id @default(uuid())
  cashSessionId String
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  type          CashMovementType
  amount        Decimal          @db.Decimal(12, 2)
  reason        String?
  userId        String?
  user          User?            @relation(fields: [userId], references: [id])
  saleId        String?
  sale          Sale?            @relation(fields: [saleId], references: [id])
  createdAt     DateTime         @default(now())

  @@index([cashSessionId])
}

/// Fechamento financeiro do dia: consolida TODOS os turnos de TODOS os
/// terminais num unico retrato e trava o dia.
///
/// O X/Z fecha um turno; este fecha o dia da loja. Sem ele, uma loja com tres
/// caixas so tem tres leituras Z que ninguem soma, e a diferenca de gaveta de
/// um operador se dilui.
///
/// O `snapshot` guarda os numeros como estavam no momento do fechamento. Nao e
/// redundancia: recalcular no futuro devolve outro numero (uma devolucao
/// lancada depois, um titulo baixado) e o fechamento deixaria de ser prova do
/// que foi conferido no dia. A reabertura e auditada e mantem o retrato
/// anterior ate que o dia seja fechado de novo.
model DailyClosing {
  id             String             @id @default(uuid())
  /// Dia de operacao no fuso do servidor, sem hora. Um fechamento por dia.
  businessDate   DateTime           @unique @db.Date
  status         DailyClosingStatus @default(FECHADO)
  closedAt       DateTime           @default(now())
  closedById     String
  closedBy       User               @relation("DailyClosingClosedBy", fields: [closedById], references: [id])
  /// Retrato completo do dia no momento do fechamento (JSON).
  snapshot       Json
  /// Campos desnormalizados do snapshot, para listar sem abrir o JSON.
  totalSales     Decimal            @db.Decimal(12, 2)
  totalCashIn    Decimal            @db.Decimal(12, 2)
  cashDifference Decimal            @db.Decimal(12, 2)
  sessionCount   Int                @default(0)
  notes          String?
  /// Quantas vezes o dia foi fechado. Fechar de novo depois de reabrir soma 1.
  version        Int                @default(1)
  reopenedAt     DateTime?
  reopenedById   String?
  reopenedBy     User?              @relation("DailyClosingReopenedBy", fields: [reopenedById], references: [id])
  reopenReason   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt

  @@index([status])
  @@index([businessDate])
}

// ---------------------------------------------------------------------------
// Configuracao da loja (registro unico) e licenca
// ---------------------------------------------------------------------------

model StoreSettings {
  id        String    @id @default(uuid())
  legalName String
  tradeName String?
  cnpj      String
  ie        String?
  im        String?
  taxRegime TaxRegime @default(SIMPLES_NACIONAL)

  addressStreet     String
  addressNumber     String
  addressComplement String?
  addressDistrict   String
  addressCity       String
  addressState      String
  addressZip        String
  phone             String?
  email             String?

  // Identidade visual: URL https:// ou data URI (imagem embutida).
  logoLightUrl String? // usado no tema claro
  logoDarkUrl  String? // usado no tema escuro

  // NFC-e
  nfceSeries          Int     @default(1)
  nfceNextNumber      Int     @default(1)
  nfceEnvironment     String  @default("homologacao")
  nfceCscId           String?
  nfceCsc             String?
  fiscalProvider      String? // ex.: "focusnfe", "plugnotas"
  fiscalProviderToken String?

  // Contingencia da NFC-e: serie propria (disjunta de nfceSeries) e contador
  // usados quando um terminal nao tem faixa reservada. `nfceContingencyActive`
  // e a chave "SEFAZ caiu, continue vendendo": toda venda concluida enquanto
  // estiver ligada emite direto na serie de contingencia.
  nfceContingencySeries     Int?
  nfceContingencyNextNumber Int     @default(1)
  nfceContingencyActive     Boolean @default(false)

  // Politica de desconto: teto (em %) que um OPERADOR pode conceder numa venda
  // sem liberacao de gerente. GERENTE e ADMIN nao tem teto.
  maxDiscountPercentOperator Decimal @default(10) @db.Decimal(5, 2)

  updatedAt DateTime @updatedAt
}

model License {
  id        String   @id @default(uuid())
  key       String   @unique
  customer  String
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Financeiro — contas a receber (crediario), contas a pagar e fluxo de caixa
//
// Um titulo e uma PROMESSA de dinheiro, com data. O caixa (CashSession) conta
// o que ja passou pela gaveta; aqui fica o que ainda vai passar — e o que saiu
// por fora dela (despesa paga por transferencia, por exemplo). Sao as duas
// metades do fluxo de caixa: realizado e projetado.
// ---------------------------------------------------------------------------

/// Parcela de crediario a receber de um cliente. Nasce no fechamento da venda,
/// uma linha por parcela, e so morre por baixa ou por cancelamento da venda.
model Receivable {
  id           String      @id @default(uuid())
  number       Int         @unique
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  /// Titulo avulso (renegociacao, acerto) nao tem venda de origem.
  saleId       String?
  sale         Sale?       @relation(fields: [saleId], references: [id])
  description  String
  /// Parcela `installment` de `installments`.
  installment  Int         @default(1)
  installments Int         @default(1)
  amount       Decimal     @db.Decimal(12, 2)
  /// Soma das baixas. Nunca passa de `amount`.
  paidAmount   Decimal     @default(0) @db.Decimal(12, 2)
  dueDate      DateTime
  status       TitleStatus @default(ABERTO)
  paidAt       DateTime?
  canceledAt   DateTime?
  note         String?

  /// Classificacao gerencial opcional (plano de contas de RECEITA e centro de
  /// custo). Nulo no titulo herdado e no que nasce da venda sem classificacao.
  categoryId   String?
  category     FinancialCategory? @relation(fields: [categoryId], references: [id])
  costCenterId String?
  costCenter   CostCenter?        @relation(fields: [costCenterId], references: [id])

  settlements ReceivableSettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, status])
  @@index([status, dueDate])
  @@index([saleId])
  @@index([categoryId])
  @@index([costCenterId])
}

/// Baixa (total ou parcial) de um titulo a receber.
model ReceivableSettlement {
  id            String            @id @default(uuid())
  receivableId  String
  receivable    Receivable        @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  amount        Decimal           @db.Decimal(12, 2)
  method        PaymentMethod
  /// Turno em que o dinheiro entrou, quando a baixa foi em especie no balcao.
  cashSessionId String?
  cashSession   CashSession?      @relation(fields: [cashSessionId], references: [id])
  /// Conta financeira em que o dinheiro caiu, quando nao foi pela gaveta
  /// (deposito, Pix, transferencia). Nulo na baixa em especie do balcao.
  accountId     String?
  account       FinancialAccount? @relation(fields: [accountId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  note          String?
  createdAt     DateTime          @default(now())

  @@index([receivableId])
  @@index([createdAt])
  @@index([accountId])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  document  String?
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payables Payable[]
}

/// Despesa a pagar. `recurrence` descreve a periodicidade da conta; a proxima
/// competencia e gerada na baixa, nunca em lote antecipado — projetar doze
/// meses de aluguel como titulo em aberto suja o fluxo de caixa.
model Payable {
  id                  String             @id @default(uuid())
  number              Int                @unique
  supplierId          String?
  supplier            Supplier?          @relation(fields: [supplierId], references: [id])
  description         String
  /// Categoria da despesa como TEXTO LIVRE (aluguel, energia, folha, ...).
  /// Legado do plano de contas informal; convive com `financialCategoryId`, que
  /// e a classificacao estruturada. Migrar o texto para o plano numa rodada
  /// futura.
  category            String             @default("Geral")
  /// Plano de contas de DESPESA e centro de custo — classificacao gerencial
  /// opcional. Nulo na despesa herdada.
  financialCategoryId String?
  financialCategory   FinancialCategory? @relation(fields: [financialCategoryId], references: [id])
  costCenterId        String?
  costCenter          CostCenter?        @relation(fields: [costCenterId], references: [id])
  amount              Decimal            @db.Decimal(12, 2)
  paidAmount          Decimal            @default(0) @db.Decimal(12, 2)
  dueDate             DateTime
  /// Data de competencia (regime de competencia), quando difere do vencimento.
  /// Nulo cai de volta em `dueDate` para efeito de relatorio.
  competencia         DateTime?
  status              TitleStatus        @default(ABERTO)
  recurrence          PayableRecurrence  @default(NENHUMA)
  paidAt              DateTime?
  canceledAt          DateTime?
  note                String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  settlements PayableSettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueDate])
  @@index([supplierId])
  @@index([category])
  @@index([financialCategoryId])
  @@index([costCenterId])
}

model PayableSettlement {
  id            String            @id @default(uuid())
  payableId     String
  payable       Payable           @relation(fields: [payableId], references: [id], onDelete: Cascade)
  amount        Decimal           @db.Decimal(12, 2)
  method        PaymentMethod
  /// Turno de onde o dinheiro saiu, quando a despesa foi paga da gaveta.
  cashSessionId String?
  cashSession   CashSession?      @relation(fields: [cashSessionId], references: [id])
  /// Conta financeira de onde o dinheiro saiu, quando nao foi da gaveta
  /// (debito em conta, Pix, transferencia). Nulo no pagamento em especie.
  accountId     String?
  account       FinancialAccount? @relation(fields: [accountId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  note          String?
  createdAt     DateTime          @default(now())

  @@index([payableId])
  @@index([createdAt])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Nucleo financeiro — contas, plano de contas, centros de custo, transferencias
//
// Contas guardam ONDE o dinheiro fica; o plano de contas e os centros de custo
// classificam POR QUE ele entrou ou saiu. O saldo de uma conta e SEMPRE
// derivado (abertura + baixas com conta + transferencias), nunca um contador
// gravado — dois lugares para o mesmo numero divergem.
// ---------------------------------------------------------------------------

/// Uma conta onde a loja guarda dinheiro: banco, caixa em especie ou carteira.
/// O saldo nao e armazenado; e calculado a partir de `openingBalance`, das
/// baixas de titulo que apontam para a conta e das transferencias.
model FinancialAccount {
  id             String               @id @default(uuid())
  name           String
  type           FinancialAccountType
  /// Agencia e numero da conta — exibicao apenas, texto livre.
  bankBranch     String?
  bankNumber     String?
  /// Ponto de partida do saldo calculado e a data a que ele se refere.
  openingBalance Decimal              @default(0) @db.Decimal(14, 2)
  openingDate    DateTime             @default(now())
  active         Boolean              @default(true)
  archivedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  receivableSettlements ReceivableSettlement[]
  payableSettlements    PayableSettlement[]
  transfersOut          AccountTransfer[]      @relation("TransferFrom")
  transfersIn           AccountTransfer[]      @relation("TransferTo")

  @@index([active])
}

/// No do plano de contas gerencial. `parentId` nulo e uma raiz; a arvore separa
/// RECEITA de DESPESA pelo `kind` e um filho herda o `kind` do pai.
model FinancialCategory {
  id        String                @id @default(uuid())
  kind      FinancialCategoryKind
  name      String
  /// Codigo contabil livre (ex.: "3.1.02"), opcional.
  code      String?
  parentId  String?
  parent    FinancialCategory?    @relation("CategoryTree", fields: [parentId], references: [id])
  children  FinancialCategory[]   @relation("CategoryTree")
  active    Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  payables    Payable[]
  receivables Receivable[]

  @@unique([kind, name, parentId])
  @@index([kind, active])
  @@index([parentId])
}

/// Centro de custo: por qual area/departamento a receita ou a despesa responde.
model CostCenter {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payables    Payable[]
  receivables Receivable[]

  @@index([active])
}

/// Transferencia de dinheiro entre duas contas da propria loja. Nao e receita
/// nem despesa: sai de uma conta e entra na outra pelo mesmo valor.
model AccountTransfer {
  id            String           @id @default(uuid())
  fromAccountId String
  fromAccount   FinancialAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     FinancialAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  amount        Decimal          @db.Decimal(14, 2)
  date          DateTime         @default(now())
  note          String?
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  createdAt     DateTime         @default(now())

  @@index([fromAccountId, date])
  @@index([toAccountId, date])
}

// ---------------------------------------------------------------------------
// Fidelidade (cashback em R$)
//
// O saldo e em REAIS, nao em pontos: ponto exige uma taxa de conversao que o
// lojista muda e o cliente nao entende, e a primeira mudanca desvaloriza o
// saldo de quem ja juntou. Cashback em R$ vale hoje o que valia ontem.
// ---------------------------------------------------------------------------

model LoyaltyAccount {
  id         String   @id @default(uuid())
  customerId String   @unique
  /// RESTRICT, nao Cascade: apagar o cliente nao pode apagar o razao do
  /// cashback dele — e a unica evidencia de saldo criado e consumido.
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Saldo disponivel para resgate. Nunca negativo.
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  earned     Decimal  @default(0) @db.Decimal(12, 2)
  redeemed   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entries LoyaltyEntry[]
}

/// Razao do saldo: toda alteracao de `LoyaltyAccount.balance` tem uma linha
/// aqui, com o saldo resultante. E o extrato que o cliente pede no balcao.
model LoyaltyEntry {
  id           String           @id @default(uuid())
  accountId    String
  account      LoyaltyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type         LoyaltyEntryType
  /// Positivo credita, negativo debita.
  amount       Decimal          @db.Decimal(12, 2)
  balanceAfter Decimal          @db.Decimal(12, 2)
  saleId       String?
  sale         Sale?            @relation(fields: [saleId], references: [id])
  reason       String?
  userId       String?
  user         User?            @relation(fields: [userId], references: [id])
  createdAt    DateTime         @default(now())

  @@index([accountId, createdAt])
  @@index([saleId])
}

// ---------------------------------------------------------------------------
// Agendamento de relatorios (F6)
// ---------------------------------------------------------------------------

/// Um relatorio que sai sozinho, no horario combinado, para um destinatario.
///
/// A regra que da forma ao modelo: o agendamento guarda O QUE e PARA QUEM, e o
/// periodo do relatorio e derivado da frequencia na hora de rodar — nao fica
/// gravado. Guardar o periodo congelaria o "ontem" do dia em que o agendamento
/// foi criado.
model ReportSchedule {
  id        String          @id @default(uuid())
  /// Chave do relatorio, conferida contra a mesma lista branca da exportacao.
  report    String
  name      String
  frequency ReportFrequency
  /// Hora local da loja em que o envio deve sair (0-23).
  hour      Int
  /// Dia da semana (0=domingo) quando SEMANAL; dia do mes (1-28) quando MENSAL.
  weekday   Int?
  monthday  Int?
  channel   ReportChannel
  /// E-mail ou telefone do destinatario. Dado pessoal: so sai mascarado nas
  /// listagens e na trilha de entregas.
  recipient String
  active    Boolean         @default(true)

  /// Quando a proxima execucao e devida. E tambem o lock logico do runner:
  /// so roda quem tem `nextRunAt <= agora`, e o campo avanca na mesma
  /// transacao que grava a entrega.
  nextRunAt DateTime
  lastRunAt DateTime?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries ReportDelivery[]

  @@index([active, nextRunAt])
}

/// Uma tentativa de envio. Existe mesmo quando falha: agendamento que erra em
/// silencio e pior do que agendamento que nao existe — o gestor acha que
/// recebeu o numero e nao recebeu.
model ReportDelivery {
  id           String               @id @default(uuid())
  /// Fica opcional para a evidencia sobreviver a remocao do agendamento: a
  /// entrega prova que custo, margem e desempenho por operador sairam do
  /// sistema, e apagar o agendamento nao pode apagar essa prova.
  scheduleId   String?
  schedule     ReportSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  /// Nome do agendamento no momento da entrega — o que resta quando ele some.
  scheduleName String
  report       String
  runAt        DateTime             @default(now())
  status       ReportDeliveryStatus
  channel      ReportChannel
  /// Destinatario MASCARADO no momento do envio.
  recipient    String
  /// Janela que o relatorio cobriu, em rotulo AAAA-MM-DD.
  periodFrom   String
  periodTo     String
  rows         Int                  @default(0)
  bytes        Int                  @default(0)
  error        String?

  @@index([scheduleId, runAt])
}
