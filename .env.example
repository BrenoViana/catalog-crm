# Backend Environment Variables
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/catalog_crm

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# Frontend
VITE_API_URL=http://localhost:3000/api

# Licenciamento por módulos
# As duas variáveis que existiam aqui (REMOTE_LICENSE_DB_URL e LICENSE_KEY_SECRET)
# foram REMOVIDAS: nenhum código as lia, e descreviam um desenho — segredo
# simétrico e banco de licenças remoto — oposto ao que está implementado. Pior:
# convidavam quem faz o deploy a colar a string de conexão real de um banco de
# licenças num .env que nada protege.
# O modelo real (chave Ed25519 assinada, verificada offline) está documentado em
# backend/.env.example: LICENSE_PUBLIC_KEY e LICENSE_RENEW_URL.

# Pagamentos
# O provedor eletronico simulado confirma qualquer valor sem cobrar. Ele so sobe
# com NODE_ENV=development ou com esta chave explicitamente ligada. Em producao,
# configure um gateway real e NAO defina esta variavel.
ALLOW_FAKE_PAYMENT_GATEWAY=false
